{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", "test", ".gitignore"]
    }
  ],
  "emulators": {
    "database": { "port": 9000 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": false
  }
}
