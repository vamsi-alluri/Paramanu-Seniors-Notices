{
  "rules": {
    ".read": false,
    ".write": false,
    "info": {
      ".read": "auth != null",
      ".write": false
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.child('usedBy').exists()",
        ".validate": "newData.hasChildren(['usedBy', 'activatedAt'])",
        "usedBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "activatedAt": {
          ".validate": "newData.val() === now"
        },
        "issued": {
          ".validate": "data.exists() && newData.val() === data.val()"
        },
        "revoked": {
          ".validate": "data.exists() && newData.val() === data.val()"
        },
        "note": {
          ".validate": "newData.val() === data.val()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
