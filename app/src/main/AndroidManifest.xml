<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The advertising ID is explicitly removed, not merely unused. Two different permissions are
      removed for the same reason: the GMS AD_ID one (from play-services-ads-identifier) and the
      Android 13+ AdServices one (from play-services-measurement's AdServices support). This app
      reads the advertising ID through neither API.

      Play reads the merged manifest: any dependency declaring AD_ID forces a "yes" on the
      advertising-ID question in the Data Safety form, which would contradict this app's listing
      ("does not ask for ... and none is collected"). firebase-analytics does pull it in, and is
      present again; the Gradle exclude of play-services-ads-identifier is what keeps that
      dependency out, and this removal keeps the guarantee if another path reintroduces it.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NoticesApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParamanuNotices">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParamanuNotices"
            android:windowSoftInputMode="adjustResize">
            <tools:validation testUrl="https://paramanuseniorshealth.org/activation?code=AXGXBBBE" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="paramanuseniorshealth.org" />
                <data android:pathPattern="/activation" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.NoticeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Applied by the SDK to notification-block payloads rendered while backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="notices_default" />

        <!--
          Belt and braces with the AD_ID permission removal above: this tells the Analytics SDK
          itself never to collect the advertising identifier, so the guarantee does not rest on
          dependency resolution alone.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!--
          Ships the Analytics SDK switched off. This is not redundant with setEnabled() in
          NoticesApplication.onCreate: the SDK initialises through its own component init, before
          onCreate runs, and without this it starts enabled and can emit first_open, which fires
          once per installation and can never be suppressed afterwards, before our gate closes.
          The manifest value is only the startup default; setAnalyticsCollectionEnabled(true) at
          runtime overrides it and persists, so the kill switch still works in both directions.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!--
          The same default for Crashlytics, for the same reason: it too initialises through its own
          component init before NoticesApplication.onCreate can close the gate, and this default guards
          against a crash early in startup being reported while collection is meant to be off. That
          is inferred from the analytics case, not observed for Crashlytics. The
          runtime setter in NoticesApplication still overrides it, so the kill switch works in
          both directions.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
          Lets the photo viewer read a cached image without the app copying it into shared storage.
          The grant is read-only and per-Intent: the viewer receives a content:// URI it can display
          and pass onward to a share target, and loses access when the task ends.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
