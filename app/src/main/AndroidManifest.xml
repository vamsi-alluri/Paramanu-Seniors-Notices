<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The advertising ID is explicitly removed, not merely unused. Two different permissions are
      removed for the same reason: the GMS AD_ID one (from play-services-ads-identifier) and the
      Android 13+ AdServices one (from play-services-measurement's AdServices support). This app
      reads the advertising ID through neither API.

      Play reads the merged manifest: any dependency declaring AD_ID forces a "yes" on the
      advertising-ID question in the Data Safety form, which would contradict this app's listing
      ("does not ask for ... and none is collected"). firebase-analytics pulled it in and has been
      removed; this keeps the guarantee if a transitive dependency reintroduces it later.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NoticesApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParamanuNotices">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParamanuNotices"
            android:windowSoftInputMode="adjustResize">
            <tools:validation testUrl="https://paramanuseniorshealth.org/activation?code=AXGXBBBE" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="paramanuseniorshealth.org" />
                <data android:pathPattern="/activation" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.NoticeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Applied by the SDK to notification-block payloads rendered while backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="notices_default" />

        <!--
          Belt and braces with the AD_ID permission removal above: this tells the Analytics SDK
          itself never to collect the advertising identifier, so the guarantee does not rest on
          dependency resolution alone.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!--
          Lets the photo viewer read a cached image without the app copying it into shared storage.
          The grant is read-only and per-Intent: the viewer receives a content:// URI it can display
          and pass onward to a share target, and loses access when the task ends.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
