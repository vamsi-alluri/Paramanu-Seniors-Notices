<!--
  Flat fill behind the bell. Deliberately plain: adaptive-icon backgrounds are masked to whatever
  shape the launcher wants, so anything with detail near the edges is cropped unpredictably.

  The colour matches NotificationAccent.DEFAULT_TRAY_COLOR, so an alert carrying no level shows the
  same purple in the tray badge as the launcher icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF6650A4"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
