<!--
  Success glyph, punched out of the level chip by LevelIcon.

  A stroked tick rather than a filled outline: the hole is the stroke itself, so the chip colour
  stays continuous around it. Round cap and join keep the ends from looking chopped once the 24dp
  artwork is scaled down into the chip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5.5,12.6 L10,17.1 L18.5,7.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.6" />
</vector>
