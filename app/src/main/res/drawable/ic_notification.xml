<!--
  The website logo (see drawable-nodpi/logo.png, which the launcher icon uses), redrawn as line art
  for a 24dp icon. The logo is a nuclear research site of the kind the association's members, BARC
  retirees, worked at: the research building, the reactor exhaust stack, and the reactor itself,
  with an atom inside it (paramanu means atom). The lettering and the starburst are left out;
  neither survives at status-bar size.

  Two consumers, which is why the tint is not baked in here:
    - setSmallIcon, where the system masks the whole shape to a colour of its own choosing;
    - the status bar, monochrome, at the system-chosen size.

  Both use only the alpha channel, so the logo's dark fills and orange frames cannot be told apart.
  The frames and orbits are therefore strokes over transparency rather than fills, and every part
  is the same opaque white; overlaps do no harm. Proportions follow the logo, scaled to fit 22 units
  wide with the bottoms aligned.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Research building: outline, then the two column and three row dividers of its 3x4 windows. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1"
        android:pathData="M1.5,10.4 L8.9,10.4 L8.9,19.5 L1.5,19.5 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.7"
        android:pathData="M3.97,10.4 L3.97,19.5 M6.43,10.4 L6.43,19.5 M1.5,12.68 L8.9,12.68 M1.5,14.95 L8.9,14.95 M1.5,17.23 L8.9,17.23" />

    <!-- Reactor exhaust stack, tapering evenly from 1.2 wide at the base to 0.6 at the top. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.7,3.9 L11.3,3.9 L11.6,20 L10.4,20 Z" />

    <!-- Reactor building: straight sides, domed top, closed along the bottom like the logo's frame. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1"
        android:pathData="M13.1,19.5 L13.1,13.6 A4.7,4.7 0 0,1 22.5,13.6 L22.5,19.5 Z" />

    <!-- Atom: one level orbit and two at +/-60 degrees around the nucleus. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M14.2,14.8 A3.6,1.4 0 1,0 21.4,14.8 A3.6,1.4 0 1,0 14.2,14.8 Z" />
    <group
        android:pivotX="17.8"
        android:pivotY="14.8"
        android:rotation="60">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="0.6"
            android:pathData="M14.2,14.8 A3.6,1.4 0 1,0 21.4,14.8 A3.6,1.4 0 1,0 14.2,14.8 Z" />
    </group>
    <group
        android:pivotX="17.8"
        android:pivotY="14.8"
        android:rotation="-60">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="0.6"
            android:pathData="M14.2,14.8 A3.6,1.4 0 1,0 21.4,14.8 A3.6,1.4 0 1,0 14.2,14.8 Z" />
    </group>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.2,14.8 A0.6,0.6 0 1,0 18.4,14.8 A0.6,0.6 0 1,0 17.2,14.8 Z" />
</vector>
