<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: the website logo, inset to sit inside the adaptive icon safe zone.

  An adaptive icon is 108dp with only the central 72dp guaranteed visible; the launcher masks the
  rest to whatever shape the device uses. The 22% inset keeps the whole mark inside that circle.

  The source is a JPEG with a white background and no transparency, which is why the background
  layer below is white rather than a brand colour: anything else would show as a square of white
  behind the mark. A transparent source is what would let this be done properly.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo"
    android:inset="22%" />
